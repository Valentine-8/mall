# 复制为 application.yml，与 jar 同目录的 config/ 下供 Spring Boot 加载
# cp application.yml.example application.yml

ruoyi:
  profile: /data/ruoyi/uploadPath

spring:
  data:
    redis:
      host: redis
      port: 6379
      password:

server:
  port: 8080

# IP 测试阶段保持模拟登录；备案+HTTPS+域名后再改 mock-enabled 与 redirect-uri
social:
  enabled: true
  mock-enabled: true
  frontend-base: http://82.156.68.87
  wechat:
    enabled: true
    redirect-uri: http://82.156.68.87/social/callback/wechat
  alipay:
    enabled: true
    redirect-uri: http://82.156.68.87/social/callback/alipay
